# Dans le dossier deploy/ :  cp .env.example .env
# Puis remplir les secrets. Ne jamais committer deploy/.env

# ── Postgres (service Docker "db") ──────────────────────────────────────────
POSTGRES_DB=db_justicia
POSTGRES_USER=justicia
POSTGRES_PASSWORD=changez-moi-un-mot-de-passe-fort

DATABASE_URL=postgresql+asyncpg://justicia:changez-moi-un-mot-de-passe-fort@db:5432/db_justicia
DATABASE_URL_SYNC=postgresql://justicia:changez-moi-un-mot-de-passe-fort@db:5432/db_justicia

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=JusticIA
# development en local ; production sur le VPS (init-env.sh s'en charge).
# En production, l'API refuse de démarrer si SECRET_KEY / mot de passe sont ceux par défaut.
APP_ENV=development
SECRET_KEY=generez-une-cle-longue-aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Port exposé sur la machine hôte.
# API_BIND=127.0.0.1 : l'API n'écoute que localement (derrière nginx/Caddy en HTTPS).
# Mettre API_BIND=0.0.0.0 pour l'exposer directement (test rapide uniquement).
API_BIND=127.0.0.1
API_PORT=8000

# Sur le VPS : domaine de l'API (DNS → IP du VPS). Active HTTPS automatique (Caddy).
# Laisser vide en local. Production : justiciaapi.mosagix.com
API_DOMAIN=

# Front (Vercel) et API. En développement, CORS autorise aussi localhost:4200.
FRONTEND_URL=https://justicia.mosagix.com
APP_PUBLIC_FRONTEND_URL=https://justicia.mosagix.com
BACKEND_URL=https://justiciaapi.mosagix.com
APP_PUBLIC_BACKEND_URL=https://justiciaapi.mosagix.com
CORS_ORIGINS=https://justicia.mosagix.com

# ── LLM : OpenAI en production (pas d'Ollama sur le VPS) ──────────────────────
LLM_PROVIDER=openai
RAG_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ── RAG ─────────────────────────────────────────────────────────────────────
# Fixé par docker-compose.yml (/app/model) — inutile de le définir ici

# ── Google ──────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-mails (confirmation d'inscription, mot de passe oublié, factures) ─────
# Rien n'est envoyé tant que EMAILS_ENABLED=false (les messages sont seulement journalisés).
# Boîte Hostinger : SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465 (SSL).
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 + mot de passe d'application.
EMAILS_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=
EMAILS_FROM_NAME=JusticIA
# Confirmation d'adresse à l'inscription (active seulement si EMAILS_ENABLED=true)
EMAIL_VERIFICATION=true

# ── Anti-robots (facultatif) : Cloudflare Turnstile ─────────────────────────
# Clé secrète ici ; la clé de site va dans Vercel (TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# ── Factures : mentions du vendeur (vide = non imprimé) ─────────────────────
INVOICE_SELLER_NAME=JusticIA
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_TAX_ID=
INVOICE_SELLER_EMAIL=

# ── Paiement Mosagix Pay ────────────────────────────────────────────────────
MOSAGIX_API_URL=
MOSAGIX_API_KEY=
MOSAGIX_WEBHOOK_SECRET=
