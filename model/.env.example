# Copier en .env — clés utilisées par les scripts du moteur (tests, ingestion).
# En Docker, ce sont les variables de deploy/.env qui priment.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Fournisseur LLM actif ──────────────────────────────────────────────────────
# ollama    → qwen2.5:14b (local, 100% confidentiel — lent sur Mac, ~1-2 min/réponse)
# openai    → GPT-4o / GPT-4o-mini (externe, test rapide)
# anthropic → Claude Sonnet (externe, haute qualité)
# LLM_PROVIDER=ollama            ← activer pour production locale (confidentiel)
# LLM_PROVIDER=openai            ← activer pour tests rapides
LLM_PROVIDER=openai               # ← actif : GPT-4o (Anthropic en pause — crédits insuffisants)

# ── HuggingFace (modèles déjà en cache local — pas besoin du hub) ─────────────
HF_HUB_OFFLINE=1          # pas de connexion réseau au hub
TOKENIZERS_PARALLELISM=false  # évite le warning de fork avec uvicorn

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-opus-4-8   # Meilleur pour le raisonnement juridique complexe
# ANTHROPIC_MODEL=claude-haiku-4-5  # ← décommenter pour réduire le coût (5x moins cher)
